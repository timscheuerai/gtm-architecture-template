      "code": {
        "version": 1,
        "language": "javascript",
        "runtime": "oxygen-js-v1",
        "source": "(inputs) => { const input = inputs;\n  const { account_key, test_round, group_id, prompt_version, variants } = input;\n  for (const [key, value] of Object.entries({account_key,test_round,group_id,prompt_version})) if (typeof value !== 'string' || !value.trim()) throw new Error(key + ' is required.');\n  if (!Array.isArray(variants) || variants.length !== 2 || variants.some(v => typeof v !== 'string' || !v.trim()) || variants[0] === variants[1]) throw new Error('Exactly two distinct variant IDs are required.');\n  // Frozen, deterministic FNV-1a bucketing. The company is the randomisation unit:\n  // colleagues in one account receive the same treatment. Never change salt/order mid-round.\n  const key = JSON.stringify([test_round.trim(), group_id.trim(), account_key.trim().toLowerCase().replace(/^www\\./, '')]);\n  let hash = 2166136261;\n  for (let i = 0; i < key.length; i++) { hash ^= key.charCodeAt(i); hash = Math.imul(hash, 16777619) >>> 0; }\n  return { test_round, group_id, variant_id: variants[hash % 2], prompt_version, assignment_key: key, algorithm: 'fnv1a-account-v1' };\n}",
        "inputs": {
          "account_key": {
            "type": "ref",
            "path": "trigger.input.account_key"
          },
          "test_round": {
            "type": "ref",
            "path": "trigger.input.test_round"
          },

{
  "name": "gtm-architecture-template",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "One GTM starter kit: company context, 42 reusable agent skills, 13 function templates and a synthetic first-batch demo.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/skills.mjs --build",
    "test": "node --test",
    "setup": "node scripts/oxygen.mjs setup",
    "preview": "node scripts/oxygen.mjs preview",
    "example": "node scripts/oxygen.mjs example",
    "status": "node scripts/oxygen.mjs status",
    "demo": "node scripts/demo.mjs",
    "skills": "node scripts/skills.mjs",
    "skills:claude": "node scripts/skills.mjs --claude",
    "check:kit": "node scripts/check-kit.mjs",
    "check:context": "python3 context/scripts/wiki_lint.py"
  },
  "license": "MIT"
}
